@model IEnumerable<StudyPlanner.Core.Models.Category>
@{
    ViewData["Title"] = "Категории";
}
<div class="container-fluid px-4 py-4">
    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            @TempData["Success"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h1 class="h3 mb-0">Категории</h1>
        <a asp-action="Create" class="btn btn-dark">+ Нова категория</a>
    </div>
    <div class="row row-cols-1 row-cols-md-3 g-4">
        @foreach (var category in Model)
        {
            <div class="col">
                <div class="card border-0 shadow-sm h-100">
                    <div class="card-body">
                        <div class="d-flex align-items-center gap-2 mb-2">
                            <div style="width:14px;height:14px;border-radius:50%;background:@(category.ColorHex ?? "#888")"></div>
                            <h5 class="card-title mb-0">@category.Name</h5>
                        </div>
                        <p class="text-muted small">@(category.Tasks?.Count ?? 0) задачи</p>
                    </div>
                    <div class="card-footer bg-transparent border-0 d-flex gap-2">
                        <a asp-action="Edit" asp-route-id="@category.Id" class="btn btn-sm btn-outline-primary">Редактирай</a>
                        <button type="button" class="btn btn-sm btn-outline-danger"
                                data-bs-toggle="modal"
                                data-bs-target="#deleteModal"
                                data-id="@category.Id"
                                data-name="@category.Name">
                            Изтрий
                        </button>
                    </div>
                </div>
            </div>
        }
    </div>
</div>

<!-- Delete Modal -->
<div class="modal fade" id="deleteModal" tabindex="-1">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header border-0">
                <h5 class="modal-title">Изтриване на категория</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                Сигурен ли си, че искаш да изтриеш категория <strong id="modalCategoryName"></strong>?
                <p class="text-muted mt-2 mb-0" style="font-size:13px">Задачите ще останат без категория.</p>
            </div>
            <div class="modal-footer border-0">
                <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Отказ</button>
                <form id="deleteForm" method="post">
                    @Html.AntiForgeryToken()
                    <button type="submit" class="btn btn-danger">Изтрий</button>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        const deleteModal = document.getElementById('deleteModal');
        deleteModal.addEventListener('show.bs.modal', function (e) {
            const btn = e.relatedTarget;
            const id = btn.getAttribute('data-id');
            const name = btn.getAttribute('data-name');
            document.getElementById('modalCategoryName').textContent = name;
            document.getElementById('deleteForm').action = '/Categories/Delete/' + id;
        });
    </script>
}