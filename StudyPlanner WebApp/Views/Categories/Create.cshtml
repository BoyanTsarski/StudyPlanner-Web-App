@model StudyPlanner.Core.Models.Category
@{
    ViewData["Title"] = "Нова категория";
}
<div class="container py-4" style="max-width: 700px;">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h1 class="h3 mb-0">Нова категория</h1>
        <a asp-action="Index" class="btn btn-outline-secondary">Назад</a>
    </div>
    <div class="card border-0 shadow-sm">
        <div class="card-body p-4">
            <form asp-action="Create" method="post" novalidate>
                @Html.AntiForgeryToken()
                <div class="mb-3">
                    <label asp-for="Name" class="form-label">Име</label>
                    <input asp-for="Name" class="form-control" placeholder="Въведи ime на категория" />
                    <span asp-validation-for="Name" class="text-danger"></span>
                </div>
                <div class="mb-3">
                    <label asp-for="ColorHex" class="form-label">Цвят</label>
                    <input asp-for="ColorHex" class="form-control form-control-color" type="color" value="#1D9E75" />
                </div>
                <div class="d-flex gap-2 mt-2">
                    <button type="submit" class="btn btn-dark">Създай категория</button>
                    <a asp-action="Index" class="btn btn-outline-secondary">Отказ</a>
                </div>
            </form>
        </div>
    </div>
</div>