@model StudyPlanner.Core.Models.Category
@{
    ViewData["Title"] = "Редактирай категория";
}

<div class="container py-4" style="max-width: 700px;">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h1 class="h3 mb-0">Редактирай категория</h1>
        <a asp-action="Index" class="btn btn-outline-secondary">Назад</a>
    </div>

    <div class="card border-0 shadow-sm">
        <div class="card-body p-4">
            <form asp-action="Edit" method="post">
                @Html.AntiForgeryToken()                
                <input asp-for="Id" type="hidden" />
                <div class="mb-3">
                    <label asp-for="Name" class="form-label">Име</label>
                    <input asp-for="Name" class="form-control" />
                    <span asp-validation-for="Name" class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="ColorHex" class="form-label">Цвят</label>
                    <input asp-for="ColorHex" class="form-control form-control-color" type="color" />
                </div>

                <div class="d-flex gap-2 mt-2">
                    <button type="submit" class="btn btn-dark">Запази промените</button>
                    <a asp-action="Index" class="btn btn-outline-secondary">Отказ</a>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}