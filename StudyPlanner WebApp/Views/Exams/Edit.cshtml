@model StudyPlanner.Core.Models.Exam
@{
    ViewData["Title"] = "Редактирай изпит";
}

<div class="container py-4" style="max-width: 700px;">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h1 class="h3 mb-0">Редактирай изпит</h1>
        <a asp-action="Index" class="btn btn-outline-secondary">Назад</a>
    </div>

    <div class="card border-0 shadow-sm">
        <div class="card-body p-4">
            <form asp-action="Edit" method="post">
                @Html.AntiForgeryToken()                
                <input asp-for="Id" type="hidden" />
                <input asp-for="UserId" type="hidden" />

                <div class="mb-3">
                    <label asp-for="Subject" class="form-label">Предмет</label>
                    <input asp-for="Subject" class="form-control" />
                    <span asp-validation-for="Subject" class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="ExamDate" class="form-label">Дата и час</label>
                    <input asp-for="ExamDate" class="form-control" type="datetime-local" />
                    <span asp-validation-for="ExamDate" class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="Location" class="form-label">Зала / Място</label>
                    <input asp-for="Location" class="form-control" />
                </div>

                <div class="mb-3">
                    <label asp-for="Notes" class="form-label">Бележки</label>
                    <textarea asp-for="Notes" class="form-control" rows="3"></textarea>
                </div>

                <div class="d-flex gap-2 mt-2">
                    <button type="submit" class="btn btn-dark">Запази промените</button>
                    <a asp-action="Index" class="btn btn-outline-secondary">Отказ</a>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}