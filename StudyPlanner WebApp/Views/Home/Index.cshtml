@{
    ViewData["Title"] = "Dashboard";
}

<div class="container-fluid px-4 py-4">
    <div id="upcoming-alerts"></div>

    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h1 class="h3 mb-0">Добре дошъл, @(ViewBag.UserName ?? User.Identity!.Name)</h1>
            <p class="text-muted mb-0">@DateTime.Now.ToString("dd MMMM yyyy")</p>
        </div>
        @if (User.Identity!.IsAuthenticated)
        {
            <a asp-controller="Tasks" asp-action="Create" class="btn btn-dark">+ Нова задача</a>
        }
    </div>

    @if (User.Identity!.IsAuthenticated)
    {
        <div class="row g-3 mb-4">
            <div class="col-md-3">
                <div class="card border-0 shadow-sm">
                    <div class="card-body">
                        <p class="text-muted small mb-1 text-uppercase" style="font-size:11px;letter-spacing:1px">Активни задачи</p>
                        <h2 class="mb-0">@(ViewBag.ActiveTasks ?? 0)</h2>
                    </div>
                </div>
            </div>
            <div class="col-md-3">
                <div class="card border-0 shadow-sm">
                    <div class="card-body">
                        <p class="text-muted small mb-1 text-uppercase" style="font-size:11px;letter-spacing:1px">Завършени задачи</p>
                        <h2 class="mb-0" style="color:#1D9E75">@(ViewBag.CompletedTasks ?? 0)</h2>
                    </div>
                </div>
            </div>
            <div class="col-md-3">
                <div class="card border-0 shadow-sm">
                    <div class="card-body">
                        <p class="text-muted small mb-1 text-uppercase" style="font-size:11px;letter-spacing:1px">Висок приоритет</p>
                        <h2 class="mb-0" style="color:#E24B4A">@(ViewBag.HighPriority ?? 0)</h2>
                    </div>
                </div>
            </div>
            <div class="col-md-3">
                <div class="card border-0 shadow-sm">
                    <div class="card-body">
                        <p class="text-muted small mb-1 text-uppercase" style="font-size:11px;letter-spacing:1px">Pomodoro сесии</p>
                        <h2 class="mb-0" id="pomodoroCount">0</h2>
                    </div>
                </div>
            </div>
        </div>

        <div class="row g-3">
            <div class="col-md-8">
                <div class="card border-0 shadow-sm">
                    <div class="card-body">
                        <div class="d-flex justify-content-between align-items-center mb-3">
                            <h5 class="card-title">Последни задачи</h5>
                            <a asp-controller="Tasks" asp-action="Index" style="font-size:13px">Виж всички</a>
                        </div>
                        @if (ViewBag.RecentTasks != null && ((IEnumerable<StudyPlanner.Core.Models.StudyTask>)ViewBag.RecentTasks).Any())
                        {
                            foreach (var task in (IEnumerable<StudyPlanner.Core.Models.StudyTask>)ViewBag.RecentTasks)
                            {
                                <div class="d-flex justify-content-between align-items-center py-2 border-bottom">
                                    <span style="font-size:14px">@task.Title</span>
                                    @if (task.Priority == StudyPlanner.Core.Enums.Priority.High)
                                    {
                                        <span class="badge" style="background:#E24B4A;border-radius:99px">Високо</span>
                                    }
                                    else if (task.Priority == StudyPlanner.Core.Enums.Priority.Medium)
                                    {
                                        <span class="badge" style="background:#EF9F27;border-radius:99px">Средно</span>
                                    }
                                    else
                                    {
                                        <span class="badge" style="background:#1D9E75;border-radius:99px">Ниско</span>
                                    }
                                </div>
                            }
                        }
                        else
                        {
                            <p class="text-muted" style="font-size:14px">Няма задачи</p>
                        }
                    </div>
                </div>
            </div>
            <div class="col-md-4">
                <div class="card border-0 shadow-sm">
                    <div class="card-body text-center">
                        <h5 class="card-title mb-3">Pomodoro таймер</h5>
                        <div id="timer" style="font-size:3rem;font-weight:500;color:#0f1c2e">25:00</div>
                        <p class="text-muted small mb-3">Фокус сесия</p>
                        <div class="d-flex gap-2 justify-content-center">
                            <button class="btn btn-dark" onclick="startTimer()">Старт</button>
                            <button class="btn btn-outline-secondary" onclick="resetTimer()">Reset</button>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    }
    else
    {
        <div class="card border-0 shadow-sm p-4 text-center">
            <h5>Добре дошъл в StudyPlanner!</h5>
            <p class="text-muted">Влез в акаунта си за да видиш задачите и изпитите си.</p>
            <a asp-area="Identity" asp-page="/Account/Login" class="btn btn-dark">Вход</a>
        </div>
    }
</div>

@section Scripts {
    <script>
        let timerInterval;
        let seconds = 25 * 60;
        let pomodoroCount = 0;

        function updateDisplay() {
            const m = Math.floor(seconds / 60).toString().padStart(2, '0');
            const s = (seconds % 60).toString().padStart(2, '0');
            document.getElementById('timer').textContent = m + ':' + s;
        }

        function startTimer() {
            if (timerInterval) return;
            timerInterval = setInterval(() => {
                if (seconds > 0) {
                    seconds--;
                    updateDisplay();
                } else {
                    clearInterval(timerInterval);
                    timerInterval = null;
                    pomodoroCount++;
                    document.getElementById('pomodoroCount').textContent = pomodoroCount;
                    seconds = 25 * 60;
                    updateDisplay();
                    alert('Сесията приключи! Почивка 5 минути.');
                }
            }, 1000);
        }

        function resetTimer() {
            clearInterval(timerInterval);
            timerInterval = null;
            seconds = 25 * 60;
            updateDisplay();
        }
    </script>
}