@model StudyPlanner.Core.Models.StudyTask

<div class="d-flex justify-content-between align-items-center py-2 border-bottom">
    <div>
        <div class="fw-500" style="font-size:14px">@Model.Title</div>
        <div style="font-size:12px;color:var(--text-muted)">
            @(Model.Category?.Name ?? "Без категория") · @Model.DueDate.ToString("dd.MM.yyyy")
        </div>
    </div>
    <div class="d-flex align-items-center gap-2">
        @if (Model.Priority == StudyPlanner.Core.Enums.Priority.High)
        {
            <span class="badge" style="background:#FCEBEB;color:#A32D2D">Високо</span>
        }
        else if (Model.Priority == StudyPlanner.Core.Enums.Priority.Medium)
        {
            <span class="badge" style="background:#FAEEDA;color:#854F0B">Средно</span>
        }
        else
        {
            <span class="badge" style="background:#EAF3DE;color:#3B6D11">Ниско</span>
        }
        <a asp-controller="Tasks" asp-action="Details" asp-route-id="@Model.Id" class="btn btn-sm btn-outline-secondary">Детайли</a>
    </div>
</div>