@model StudyPlanner.Core.Models.Exam

<div class="d-flex align-items-center gap-3 py-2 border-bottom">
    <div style="min-width:44px;height:48px;background:#0f1c2e;border-radius:8px;display:flex;flex-direction:column;align-items:center;justify-content:center;">
        <div style="font-size:16px;font-weight:500;color:#fff;line-height:1">@Model.ExamDate.Day</div>
        <div style="font-size:10px;color:#1D9E75">@Model.ExamDate.ToString("MMM").ToUpper()</div>
    </div>
    <div class="flex-grow-1">
        <div style="font-size:14px;font-weight:500">@Model.Subject</div>
        <div style="font-size:12px;color:var(--text-muted)">
            @(Model.Location ?? "—") · @Model.ExamDate.ToString("HH:mm")
        </div>
    </div>
    <a asp-controller="Exams" asp-action="Details" asp-route-id="@Model.Id" class="btn btn-sm btn-outline-secondary">Детайли</a>
</div>