@model Microsoft.AspNetCore.Mvc.ProblemDetails
@{
    ViewData["Title"] = "Грешка";
    var statusCode = Context.Response.StatusCode;
}

<div class="container py-5 text-center">
    <div class="card border-0 shadow-sm mx-auto" style="max-width:500px">
        <div class="card-body p-5">
            <div style="font-size:4rem;font-weight:500;color:#0f1c2e">
                @statusCode
            </div>
            <h2 class="mb-3">
                @if (statusCode == 404)
                {
                    <span>Страницата не е намерена</span>
                }
                else if (statusCode == 401)
                {
                    <span>Нямате достъп</span>
                }
                else if (statusCode == 403)
                {
                    <span>Забранен достъп</span>
                }
                else
                {
                    <span>Възникна грешка</span>
                }
            </h2>
            <p class="text-muted mb-4">
                @if (statusCode == 404)
                {
                    <span>Страницата която търсите не съществува.</span>
                }
                else if (statusCode == 401)
                {
                    <span>Трябва да влезете в профила си.</span>
                }
                else
                {
                    <span>Моля опитайте отново по-късно.</span>
                }
            </p>
            <a asp-controller="Home" asp-action="Index" class="btn btn-dark">Към началото</a>
        </div>
    </div>
</div>