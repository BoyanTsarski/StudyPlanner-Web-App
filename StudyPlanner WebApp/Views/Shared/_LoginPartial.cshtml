@using Microsoft.AspNetCore.Identity
@using StudyPlanner.Core.Models
@inject SignInManager<ApplicationUser> SignInManager
@inject UserManager<ApplicationUser> UserManager
<ul class="navbar-nav">
    @if (SignInManager.IsSignedIn(User))
    {
        <li class="nav-item">
            <a class="nav-link text-white-50" asp-area="" asp-controller="Profile" asp-action="Index" title="Профил">
                Hello @User.Identity?.Name!
            </a>
        </li>
        <li class="nav-item">
            <a class="nav-link text-white-50" href="javascript:document.getElementById('logoutForm').submit()">Logout</a>
        </li>
    }
    else
    {
        <li class="nav-item">
            <a class="nav-link text-white-50" asp-area="Identity" asp-page="/Account/Register">Регистрация</a>
        </li>
        <li class="nav-item">
            <a class="nav-link text-white-50" asp-area="Identity" asp-page="/Account/Login">Вход</a>
        </li>
    }
</ul>
@if (SignInManager.IsSignedIn(User))
{
    <form id="logoutForm" asp-area="Identity" asp-page="/Account/Logout" asp-route-returnUrl="@Url.Action("Index", "Home", new { area = "" })" method="post" style="display:none">
        @Html.AntiForgeryToken()
    </form>
}