@{
    ViewData["Title"] = "Admin Panel";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container mt-4">
    <h1>Admin Panel</h1>
    <p>Добре дошъл в администраторския панел.</p>

    <div class="row mt-4">
        <div class="col-md-4">
            <div class="card">
                <div class="card-body">
                    <h5 class="card-title">Потребители</h5>
                    <p class="card-text">Управление на потребителите.</p>
                    <a href="#" class="btn btn-dark">Виж всички</a>
                </div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card">
                <div class="card-body">
                    <h5 class="card-title">Задачи</h5>
                    <p class="card-text">Преглед на всички задачи.</p>
                    <a href="#" class="btn btn-dark">Виж всички</a>
                </div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card">
                <div class="card-body">
                    <h5 class="card-title">Категории</h5>
                    <p class="card-text">Управление на категориите.</p>
                    <a href="#" class="btn btn-dark">Виж всички</a>
                </div>
            </div>
        </div>
    </div>
</div>